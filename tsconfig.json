{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "lib": ["ES2022", "DOM"],
    "strict": true, "noUncheckedIndexedAccess": true, "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true, "declaration": true,
    "rootDir": "src", "outDir": "dist", "skipLibCheck": true
  },
  "include": ["src/*.ts"]
}
